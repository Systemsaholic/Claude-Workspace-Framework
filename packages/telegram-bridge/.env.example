# Telegram Bridge Configuration
# Copy this file to .env and fill in your values

# Telegram Bot Settings (from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Claude Model - Haiku recommended for rate limits & chat responsiveness
CLAUDE_MODEL=claude-3-5-haiku-20241022
MAX_TOKENS=2048

# Alternative: Use Sonnet for more complex tasks (higher token usage)
# CLAUDE_MODEL=claude-sonnet-4-20250514
# MAX_TOKENS=4096

# Service Settings (optional)
# HOST=0.0.0.0
# PORT=8420

# Workspace Settings
# WORKSPACE_PATH=/path/to/your/workspace
# SYSTEM_PROMPT_FILE=/path/to/custom/prompt.md
# MCP_CONFIG_PATH=/path/to/.mcp.json
