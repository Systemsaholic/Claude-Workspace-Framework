# cPanel/WHM MCP Server Configuration
#
# Copy to .env and fill in your values
#

# WHM server URL (the server hostname)
# Example: https://syshost02.systemsaholic.net:2087
CPANEL_WHM_URL=https://your-server.example.com:2087

# WHM API token (preferred over username/password)
# Generate in WHM: Development > Manage API Tokens
CPANEL_API_TOKEN=your-api-token-here

# WHM username (root or reseller)
CPANEL_USERNAME=root

# Request timeout in seconds
CPANEL_REQUEST_TIMEOUT=30

# Allow insecure connections (for self-signed certs)
CPANEL_ALLOW_INSECURE=false
